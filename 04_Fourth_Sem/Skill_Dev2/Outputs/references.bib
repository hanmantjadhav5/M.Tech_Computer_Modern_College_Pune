	file = {PDF:C\:\\Users\\hanmant\\Zotero\\storage\\SHFL6EPE\\Mittal et al. - 2024 - DermCDSM Clinical Decision Support Model for Dermatosis Using Systematic Approaches of Machine Lear.pdf:application/pdf},
